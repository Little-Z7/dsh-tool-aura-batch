{
  "name": "dsh-tool-aura-batch",
  "version": "0.3.0",
  "description": "DeepSeek Harness 插件：把剧本与参考素材整理成灵环 TV「导入分镜与参考素材」可直接导入的格式（分镜文档 + 参考图 zip），并检查、打包",
  "license": "MIT",
  "author": "Little-Z7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Z7/dsh-tool-aura-batch.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --import ./test/stub-loader.mjs --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
